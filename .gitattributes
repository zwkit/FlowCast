# Deterministic line endings: LF in the repository and on checkout.
* text=auto eol=lf

# Shell scripts and the Gradle wrapper break with CRLF on Linux/CI runners.
*.sh text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets (never normalize).
*.png binary
*.jpg binary
*.webp binary
*.a binary
*.so binary
*.jar binary
*.keystore binary
*.apk binary
*.aab binary
